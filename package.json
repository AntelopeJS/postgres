{
  "name": "@antelopejs/postgres",
  "version": "0.2.3",
  "description": "PostgreSQL backend for AntelopeJS, implementing the Database interface on relational tables with native column types and indexes",
  "keywords": [
    "antelopejs",
    "database",
    "postgres",
    "postgresql",
    "sql"
  ],
  "homepage": "https://interfaces.antelopejs.com/docs/database",
  "bugs": {
    "url": "https://github.com/AntelopeJS/postgres/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/postgres.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint && antelopejs-check-interface-ranges",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test . && pnpm run test:external:run",
    "test:external": "pnpm run build && pnpm run test:external:run",
    "test:external:run": "PG_TEST_MODE=external ajs module test . $(for file in dist/test-external/*.test.js; do printf -- '-f %s ' \"$file\"; done)",
    "test:unit": "pnpm run build && mocha \"dist/test/unit/**/*.spec.js\"",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.1.1 <1.0.0",
    "@antelopejs/interface-database": "file:.campaign/tgz/antelopejs-interface-database-beec46b.tgz",
    "@antelopejs/interface-database-catalog": ">=0.0.3 <0.1.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.14.0",
    "@antelopejs/tooling-configs": "^0.2.17",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.20.0",
    "chai": "^4.5.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "mocha": "^11.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "@antelopejs/interface-database": "file:.campaign/tgz/antelopejs-interface-database-beec46b.tgz"
    }
  },
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-database",
      "@antelopejs/interface-database-catalog"
    ],
    "defaultConfig": {
      "url": "postgres://postgres@localhost:5432/antelopejs",
      "migrations": "safe"
    },
    "test": "src/test/antelope.test.ts"
  }
}
