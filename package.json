{
  "name": "@antelopejs-private/postgres",
  "version": "0.1.2",
  "description": "PostgreSQL module that implements the Database interface of antelopejs",
  "keywords": [
    "antelopejs",
    "database",
    "postgres",
    "postgresql",
    "sql"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/postgres.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "registry": "https://npm.antelopejs.cloud/"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test .",
    "test:unit": "pnpm run build && mocha \"dist/test/unit/**/*.spec.js\"",
    "typecheck": "tsc --noEmit",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-core": "^0.1.1",
    "@antelopejs/interface-database": "^0.1.6",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.9.1",
    "@antelopejs/tooling-configs": "^0.0.4",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.20.0",
    "chai": "^4.5.0",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "mocha": "^11.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-database"
    ],
    "defaultConfig": {
      "url": "postgres://postgres@localhost:5432/antelopejs",
      "migrations": "safe"
    },
    "test": "src/test/antelope.test.ts"
  }
}
