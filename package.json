{
  "name": "@antelopejs/postgres",
  "version": "0.1.0",
  "description": "PostgreSQL module that implements the Database interface of antelopejs",
  "keywords": [
    "antelopejs",
    "postgres",
    "postgresql",
    "database",
    "sql"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/postgres.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "lint": "biome check .",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test .",
    "test:unit": "pnpm run build && mocha \"dist/test/unit/**/*.spec.js\"",
    "typecheck": "tsc --noEmit"
  },
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-database"
    ],
    "defaultConfig": {
      "url": "postgres://postgres@localhost:5432/antelopejs",
      "migrations": "safe"
    },
    "test": "src/test/antelope.test.ts"
  },
  "dependencies": {
    "@antelopejs/interface-core": "^0.0.3",
    "@antelopejs/interface-database": "^0.1.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.20.0",
    "chai": "^4.5.0",
    "mocha": "^11.0.0",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
