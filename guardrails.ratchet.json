{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 2,
    "anti-slop/no-chained-type-assertions": 2,
    "anti-slop/no-known-value-widening": 3,
    "anti-slop/no-runtime-typeof": 7,
    "anti-slop/no-unknown-parameters": 32,
    "anti-slop/no-unknown-returns": 6,
    "anti-slop/no-unsafe-dictionary-type": 19,
    "anti-slop/require-safety-comment-for-type-assertion": 16,
    "typescript/no-unsafe-argument": 2,
    "typescript/no-unsafe-assignment": 1,
    "typescript/no-unsafe-return": 22,
    "typescript/unbound-method": 1
  },
  "oversizeFiles": {}
}
